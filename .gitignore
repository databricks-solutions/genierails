# OS
.DS_Store

# IDE
.idea/

# Python
__pycache__/
*.pyc

# Environment / secrets
.env
*conf*.json

# Terraform state (may contain secrets)
*.tfstate
*.tfstate.backup
# Timestamped backups from terraform state mv/rm (terraform.tfstate.<time>.backup)
*.tfstate.*.backup
.terraform/

# AI-generated output (user-specific)
generated/
masking_functions.sql

# User-created environment directories
envs/

# Rehearse/release receipts and release manifests (unless GENIERAILS_STATE_DIR is set)
.genierails-state/

# Dev-to-prod sample ownership record (per-clone runtime state)
/.dev_to_prod_sample_env.json

# Local import IDs
import_ids.env

# User-specific credentials (only track the .example)
auth.auto.tfvars

# Auto-created Genie agent ID (managed by Terraform lifecycle)
.genie_space_id

# Parallel test runner logs
shared/scripts/logs/
