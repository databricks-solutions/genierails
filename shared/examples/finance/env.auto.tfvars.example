# ============================================================================
# Finance Example — Environment Config
# ============================================================================
# This file lives at envs/<env>/env.auto.tfvars
# ============================================================================

uc_tables = [
  "fin_catalog.finance.customers",
  "fin_catalog.finance.credit_cards",
  "fin_catalog.finance.transactions",
  "fin_catalog.finance.accounts",
]

genie_spaces = [
  {
    name = "Finance Analytics"
    # Durable explicit ACL; omit or use null to derive from current policies.
    # Use [] to grant nobody.
    acl_groups = ["Junior_Analyst", "Senior_Analyst", "Compliance_Officer"]
    config = {
      title       = "Finance Analytics"
      description = "AI-powered analytics for the finance domain with role-based data governance."
    }
  },
]

sql_warehouse_id = ""   # auto-create serverless warehouse
