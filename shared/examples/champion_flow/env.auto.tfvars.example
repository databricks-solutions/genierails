# ============================================================================
# GenieRails Champion Flow — Environment Config (native-classification flow)
# ============================================================================
# Copy to envs/dev/env.auto.tfvars. Run all `make` commands from the cloud
# root (`cd aws` or `cd azure`). The champion flow reads NATIVE UC Data
# Classification as the sensitivity source and derives one gr_treatment per
# column. See README.md.
#
# NOTE on prod: do NOT hand-copy this file to envs/prod/. `make promote`
# WRITES envs/prod/env.auto.tfvars (with the discovered genie_spaces + the
# catalog-remapped uc_tables). EDIT that promote-written file to add the prod
# runtime settings (sql_warehouse_id / enable_classification /
# business_access_enabled); do not overwrite it.
# ============================================================================

# --- Footprint: the tables the Genie agent can reach -----------------------
uc_tables = [
  "serverless_stable_pyecip_catalog.genierails_e2e.customers",
  "serverless_stable_pyecip_catalog.genierails_e2e.payments",
  "serverless_stable_pyecip_catalog.genierails_e2e.notes",
]

# --- The curated Genie Space to govern + promote ---------------------------
# genie_space_id = "" + at least one uc_tables entry => a space is created.
# Use [] for a table-only footprint (no Genie space), as in the live e2e.
genie_spaces = [
  { genie_space_id = "" },   # paste your curated dev Space id (Genie UI URL)
]

sql_warehouse_id = ""     # paste your SQL warehouse id

# --- Native classification (the sensitivity source) ------------------------
# Turns on UC Data Classification AND auto-tagging (auto_tag_configs =
# AUTO_TAGGING_ENABLED) for the footprint via the
# databricks_data_classification_catalog_config resource (provider ~> 1.111.0).
# Without auto-tagging the scan writes NO class.* tags. Auto-tagging covers:
#   card_security_code, credit_card, date_of_birth, email_address, name,
#   phone_number, us_ssn  (extend classification_auto_tags in
#   shared/modules/data_access/main.tf for more types).
# Requires APPLY TAG on the catalog + ASSIGN on the class.* tags for the
# deploying principal. Tags land on the next scan (up to ~24h) — not instant.
# When true, `make generate` is FAIL-CLOSED: it aborts if native class.* tags
# cannot be read (opt into inference only with GENERATE_ARGS='... --allow-llm-sensitivity').
enable_classification = true

# --- Exposure gate ---------------------------------------------------------
# Hold the business SELECT grant + Genie exposure until the coverage gate is
# GREEN. Keep false through dev rehearsal and prod re-derivation; flip to true
# only in Phase 5 (then `make apply`, which releases the data_access SELECT).
business_access_enabled = false

# ============================================================================
# COMMAND CHEAT-SHEET (run from cd aws / cd azure)
# ----------------------------------------------------------------------------
# Consume IdP groups (required — consume-by-default needs a group->tier map):
#   make generate ENV=dev GENERATE_ARGS='--groups "payments_ops,regional_analysts,viewers"'
# Explicit LLM/DDL opt-out (only if you accept inference):
#   make generate ENV=dev GENERATE_ARGS='--groups "..." --allow-llm-sensitivity'
# Effective-access checks need a key column shared by all footprint tables:
#   make verify-access ENV=dev VERIFY_KEY_COLUMN=<pk>
# ============================================================================
