# ============================================================================
# GenieRails Champion Flow — Environment Config (native-classification flow)
# ============================================================================
# Copy to envs/dev/env.auto.tfvars (and envs/prod/ after `make promote`).
# The champion flow reads NATIVE UC Data Classification as the sensitivity
# source and derives one gr_treatment per column. See README.md.
# ============================================================================

# --- Footprint: the tables the Genie agent can reach -----------------------
uc_tables = [
  "serverless_stable_pyecip_catalog.genierails_e2e.customers",
  "serverless_stable_pyecip_catalog.genierails_e2e.payments",
  "serverless_stable_pyecip_catalog.genierails_e2e.notes",
]

# --- The curated Genie Space to govern + promote ---------------------------
genie_spaces = [
  {
    genie_space_id = ""   # paste your curated dev Space id (Genie UI URL)
    # name + tables are auto-discovered from the existing Space
  },
]

sql_warehouse_id = ""     # paste your SQL warehouse id

# --- Native classification (the sensitivity source) ------------------------
# Turns on UC Data Classification + auto-tagging for the footprint via the
# databricks_data_classification_catalog_config resource (provider >= 1.111.0).
# When true, `make generate` is FAIL-CLOSED: it aborts if native class.* tags
# cannot be read (opt into inference only with --allow-llm-sensitivity).
enable_classification = true

# --- Exposure gate ---------------------------------------------------------
# Hold the business SELECT grant + Genie business exposure until the coverage
# gate is GREEN. Keep false through dev rehearsal and prod re-derivation;
# flip to true only in Phase 5, after `make coverage-gate` passes on prod.
business_access_enabled = false

# --- Identity: consume IdP-synced groups (never mint) ----------------------
# Pass group names at generate time:
#   make generate ENV=dev GROUPS="payments_ops,regional_analysts,viewers"
# GenieRails looks them up and refuses to invent groups. Groups arrive per-env
# via AIM/SCIM, so they are NOT promoted — only the group->tier mapping is.

# ============================================================================
# PROD (after `make promote SOURCE_ENV=dev DEST_ENV=prod DEST_CATALOG_MAP=...`)
# ----------------------------------------------------------------------------
# uc_tables = [
#   "finclear_sdp_demo_catalog.genierails_e2e.customers",
#   "finclear_sdp_demo_catalog.genierails_e2e.payments",
#   "finclear_sdp_demo_catalog.genierails_e2e.notes",
# ]
# sql_warehouse_id        = "757ed630ccf6bac1"
# enable_classification   = true
# business_access_enabled = false   # -> true only in Phase 5, after the gate is green
# ============================================================================
