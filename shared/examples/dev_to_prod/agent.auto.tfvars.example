# ============================================================================
# GenieRails Dev-to-Prod Walkthrough — one Genie agent (agent file)
# ============================================================================
# One file per agent: envs/dev/agents/<agent name>.auto.tfvars. `make setup
# ENV=dev` copies this to envs/dev/agents/Finance Analytics.auto.tfvars (only
# with a new env.auto.tfvars and no agent file yet): rename it to your agent's
# name. For another agent, from the cloud root (cd aws|azure):
#   cp ../shared/examples/dev_to_prod/agent.auto.tfvars.example "envs/dev/agents/<agent name>.auto.tfvars"
# The file name is the agent's name: letters, digits, spaces, '_', '-' or '.'.
# `make generate ENV=dev` captures the agent beside this file
# (<agent name>.space.json) and `make promote-to ENV=prod` seeds prod's file.
# ============================================================================

# Agent ID: Genie UI > your agent > Configure > About this agent > Agent ID
# (or the <id> in its /genie/rooms/<id> URL). Its tables are discovered from it.
genie_space_id = "<your-genie-space-id>"

# Who may run the agent: the groups that get Genie CAN_RUN on it, and nothing
# else (SELECT on its tables comes only from table_readers in env.auto.tfvars;
# `make generate` proposes entries for this agent's tables). Required: a
# missing acl_groups stops the run. [] means nobody. Pick them from your
# access_tier_groups (only tier groups and raw_exempt_principals can read the
# agent's tables), e.g. ["regional_analysts", "viewers"].
acl_groups = ["<group-that-may-run-the-agent>"]
