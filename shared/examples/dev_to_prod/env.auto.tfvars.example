# ============================================================================
# GenieRails Dev-to-Prod Walkthrough — env.auto.tfvars (native-classification flow)
# ============================================================================
# Copy to envs/dev/env.auto.tfvars. Run make from the cloud root (cd aws|azure).
# Auth (SP client_id/client_secret + workspace host/id) goes in a SEPARATE file:
#   envs/dev/auth.auto.tfvars  (created by `make setup ENV=dev`).
# Consume mode is already the default in envs/account/env.auto.tfvars (written
# by `make setup`). Do not set manage_groups in this workspace file.
# Do NOT hand-copy this to envs/prod/ — `make promote` WRITES envs/prod/env.auto.tfvars;
# edit that promoted file (set sql_warehouse_id; the safe classification and
# coverage check defaults are already written). See README.md.
# ============================================================================

# --- Your Genie agent and access tiers (the only edits) -------------------
# Agent ID: Genie UI > your agent > Configure > About this agent > Agent ID
# (or the <id> in its /genie/rooms/<id> URL). Its tables are discovered
# automatically by the import (`make generate ENV=dev MODE=genie`).
genie_spaces = [
  { genie_space_id = "<your-genie-space-id>" },
]

# Your existing IdP-synced groups, one per access tier, MOST to LEAST
# privileged, e.g. ["payments_ops", "regional_analysts", "viewers"]. Every
# `make generate` reads this, and `make promote` carries it to prod. (Or leave
# [] and pass GENERATE_ARGS='--groups "a,b,c"' once; it is saved here.)
access_tier_groups = []

# Existing serverless warehouse id, OR leave "" to AUTO-CREATE a serverless PRO
# warehouse in this workspace.
sql_warehouse_id = ""

# Non-sensitive, unique id column on your tables (never a masked column), used
# by rehearse/release to prove masking row by row. `make promote` carries it.
# verify_key_column = "customer_id"

# --- Native classification (the sensitivity source) ------------------------
# Enables UC Data Classification scanning for the footprint (applied by
# `make enable-classification ENV=dev`, run BEFORE `make generate`). Requires
# the deploying SP to hold catalog APPLY TAG + ASSIGN on the class.* tags.
# With this true, `make generate` is FAIL-CLOSED: it aborts if native class.*
# tags can't be read (opt into inference only with
#   GENERATE_ARGS='--allow-llm-sensitivity').
enable_classification = true

# Review detections first; set true to let class.* tags land on columns.
enable_auto_tagging = false

# --- Business exposure -----------------------------------------------------
# Nothing to set: business_access_enabled is no longer needed (deprecated and
# ignored; false does NOT revoke access). Terraform grants the business SELECT
# and the per-space Genie CAN_RUN ACL only after the coverage check passes. Every
# plan/apply re-reads live UC state and runs the check; `make rehearse` (dev) and
# `make release` (prod) orchestrate the full flows. To withdraw access, remove
# the groups or acl_groups entries and apply. (Workspace
# assignment + workspace_consume entitlement apply on every apply; warehouse
# CAN_USE is NOT managed by GenieRails.)

# --- Advanced (optional) ---------------------------------------------------
# Most users need none of this. If you use an alternative below, REPLACE the
# genie_spaces line above (a setting may appear only once in this file).
# Per-agent ACL: add acl_groups to an entry (omitted/null = derive from policy
# principals; [] = grant nobody).
#
# List the tables explicitly (e.g. the SAMPLE_ENV.md snippet):
# uc_tables = [
#   "dev_finance.genierails_e2e.customers",
#   "dev_finance.genierails_e2e.payments",
#   "dev_finance.genierails_e2e.notes",
# ]
#
# Create a NEW agent from tables (genie_space_id = "" + uc_tables):
# genie_spaces = [
#   { genie_space_id = "", name = "APJ Finance Agent",
#     uc_tables = ["dev_finance.genierails_e2e.customers",
#                  "dev_finance.genierails_e2e.payments",
#                  "dev_finance.genierails_e2e.notes"] },
# ]
#
# Govern data only (no agent, no Genie CAN_RUN): genie_spaces = [] + uc_tables.

# ============================================================================
# GREENFIELD SEQUENCE (from cd aws | cd azure):
#   make setup ENV=dev                    # then copy this file, fill auth.auto.tfvars,
#                                         # genie_space_id + access_tier_groups
#   make generate ENV=dev MODE=genie
#   # imports the agent; its tables land in envs/dev/data_access/discovered_uc_tables.auto.tfvars
#   make enable-classification ENV=dev    # turn on classification scanning (or use the UI)
#   # review detections, then set enable_auto_tagging=true and re-run the command
#   # poll system.information_schema.column_tags for class.* on your footprint
#   make generate ENV=dev
#   make rehearse ENV=dev VERIFY_KEY_COLUMN=customer_id   # or set verify_key_column below
#   # = live derive -> validate-generated -> coverage-gate -> apply -> verify-access
# ============================================================================
