# ============================================================================
# GenieRails Dev-to-Prod Walkthrough — env.auto.tfvars (native-classification flow)
# ============================================================================
# Copy to envs/dev/env.auto.tfvars. Run make from the cloud root (cd aws|azure).
# Auth (SP client_id/client_secret + workspace host/id) goes in a SEPARATE file:
#   envs/dev/auth.auto.tfvars  (created by `make setup ENV=dev`).
# Consume mode is already the default in envs/account/env.auto.tfvars (written
# by `make setup`). Do not set manage_groups in this workspace file.
# Do NOT hand-copy this to envs/prod/ — `make promote` WRITES envs/prod/env.auto.tfvars;
# edit that promoted file (set sql_warehouse_id; the safe classification and
# exposure-gate defaults are already written). See README.md.
# ============================================================================

# --- Footprint: the tables the Genie agent can reach -----------------------
uc_tables = [
  "dev_finance.genierails_e2e.customers",
  "dev_finance.genierails_e2e.payments",
  "dev_finance.genierails_e2e.notes",
]

# --- The curated Genie agent to govern + promote ---------------------------
# NOTE: genie_spaces=[] governs DATA ONLY (no agent, no Layer-3 CAN_RUN). To
# deploy the Genie agent, configure an entry below (existing id, or id="" +
# uc_tables to create one). To govern a curated agent, paste
# its id from the Genie UI URL (a space is created when genie_space_id="" AND
# uc_tables is non-empty). Leaving genie_space_id="" with NO uc_tables creates
# nothing, so prefer [] unless you fill one of them in.
# Per-agent ACL intent belongs only on each entry here: omit acl_groups or set
# it to null to derive from current policy to_principals + except_principals;
# set acl_groups = [] to grant nobody. Generated drafts do not own ACL intent.
genie_spaces = []
# genie_spaces = [
#   { genie_space_id = "0123456789abcdef" },              # govern an existing curated Space, or
#   { genie_space_id = "", name = "APJ Finance Agent",     # create a new Space from these tables
#     uc_tables = ["dev_finance.genierails_e2e.customers",
#                  "dev_finance.genierails_e2e.payments",
#                  "dev_finance.genierails_e2e.notes"],
#     acl_groups = null }, # null/omitted = derive; [] = nobody
# ]

# Existing serverless warehouse id, OR leave "" to AUTO-CREATE a serverless PRO
# warehouse in this workspace.
sql_warehouse_id = ""

# --- Native classification (the sensitivity source) ------------------------
# Enables UC Data Classification scanning for the footprint (applied by
# `make enable-classification ENV=dev`, run BEFORE `make generate`). Requires
# the deploying SP to hold catalog APPLY TAG + ASSIGN on the class.* tags.
# With this true, `make generate` is FAIL-CLOSED: it aborts if native class.*
# tags can't be read (opt into inference only with
#   GENERATE_ARGS='--groups "..." --allow-llm-sensitivity').
enable_classification = true

# Review detections first; set true to let class.* tags land on columns.
enable_auto_tagging = false

# --- Exposure gate ---------------------------------------------------------
# Holds the business SELECT grant AND the per-space Genie CAN_RUN ACL until the
# coverage gate is green. Keep FALSE through dev rehearsal and prod re-derivation.
# Flip to true in dev ONLY after the dev coverage gate passes (to run
# verify-access), and in prod ONLY in Phase 5 after the prod gate passes.
# (Workspace assignment + workspace_consume entitlement apply on every apply,
# regardless of this flag; warehouse CAN_USE is NOT managed by GenieRails.)
business_access_enabled = false

# ============================================================================
# GREENFIELD SEQUENCE (from cd aws | cd azure):
#   make setup ENV=dev                    # then copy this file, fill auth.auto.tfvars + this file
#   # envs/account/env.auto.tfvars already defaults manage_groups to false;
#   # do not set manage_groups in this workspace file
#   make enable-classification ENV=dev    # turn on classification scanning (or use the UI)
#   # review detections, then set enable_auto_tagging=true and re-run the command
#   # poll system.information_schema.column_tags for class.* on your footprint
#   make generate ENV=dev GENERATE_ARGS='--groups "payments_ops,regional_analysts,viewers"'
#   make rehearse ENV=dev VERIFY_KEY_COLUMN=customer_id
#   # = coverage-gate -> validate-generated -> apply -> verify-access (gate opened for this run only)
# ============================================================================
