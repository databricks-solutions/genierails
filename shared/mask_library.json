{
  "schema_version": 1,
  "identifier_partial_default": "hmac_sha256",
  "settings": {
    "hash_fallback": null,
    "redacted_string": "[REDACTED]",
    "normalization": "trim, NFKC, uppercase, remove spaces and hyphens"
  },
  "protection_order": ["raw", "partial", "hmac_sha256", "redacted"],
  "never_raw_classes": ["card_security_code", "card_pin", "card_track_data", "secret"],
  "versions": {
    "redacted": {"STRING": "redact_string", "DATE": "null_date", "TIMESTAMP": "null_timestamp", "NUMERIC": "null_numeric"},
    "null": {"STRING": "null_string", "DATE": "null_date", "TIMESTAMP": "null_timestamp", "NUMERIC": "null_numeric"},
    "last4": {"STRING": "last4_string"},
    "hmac_sha256": {"STRING": "hmac_string", "NUMERIC": "hmac_numeric"},
    "email_partial": {"STRING": "email_partial_string"},
    "initials": {"STRING": "initials_string"},
    "year": {"DATE": "year_date", "TIMESTAMP": "year_timestamp"},
    "age_band_10": {"NUMERIC": "age_band_10_numeric"},
    "credit_score_band_50": {"NUMERIC": "credit_score_band_50_numeric"},
    "rounded": {"NUMERIC": "rounded_numeric"},
    "ip_network": {"STRING": "ip_network_string"},
    "mac_vendor": {"STRING": "mac_vendor_string"},
    "url_domain": {"STRING": "url_domain_string"},
    "location_1dp": {"NUMERIC": "location_1dp_numeric"},
    "prefix_3": {"STRING": "prefix_3_string"},
    "raw": {"STRING": "raw_string", "DATE": "raw_date", "TIMESTAMP": "raw_timestamp", "NUMERIC": "raw_numeric"}
  },
  "treatments": {
    "financial_card": {"classes": ["credit_card"], "partial": "last4", "full": "redacted", "types": ["STRING"]},
    "financial_card_secret": {"classes": ["card_security_code", "card_pin", "card_track_data"], "partial": "redacted", "full": "redacted", "types": ["STRING"], "never_raw": true},
    "card_expiration": {"classes": ["card_expiration_date"], "partial": "redacted", "full": "redacted", "types": ["STRING", "DATE", "TIMESTAMP"]},
    "financial_account": {"classes": ["bank_number", "iban_code", "swift_code", "us_bank_number", "uk_sort_code"], "partial": "last4", "full": "redacted", "types": ["STRING"]},
    "identifier": {"classes": ["ae_emirates_id", "au_medicare", "au_tfn", "br_cnpj", "br_cns", "br_cpf", "br_pis", "br_rg", "br_titulo_eleitor", "ca_health_number", "ca_pr_card", "ca_social_insurance_number", "ch_ahv", "de_id_card", "de_svnr", "de_tax_id", "dk_cpr", "driver_license", "es_business_tax_id", "es_dni", "es_nie", "fr_id_card", "fr_nir", "fr_tax_id", "health_plan_beneficiary_number", "il_teudat_zehut", "imei", "in_aadhaar", "in_esic", "in_pan", "in_uan", "in_voter_id", "it_codice_fiscale", "it_id_card", "it_partita_iva", "jp_my_number", "jp_pension_number", "license_plate", "medical_device_id", "medical_license", "medical_record_number", "mx_curp", "mx_nss", "mx_rfc", "mx_voter_id", "nl_bsn", "no_d_number", "no_fodselsnummer", "passport", "se_personnummer", "uk_nhs", "uk_nino", "uk_utr", "us_driver_license", "us_itin", "us_passport", "us_ssn", "vin"], "partial": "$identifier_partial_default", "full": "redacted", "types": ["STRING", "NUMERIC"]},
    "email": {"classes": ["email_address"], "partial": "email_partial", "full": "redacted", "types": ["STRING"]},
    "phone": {"classes": ["phone_number"], "partial": "last4", "full": "redacted", "types": ["STRING"]},
    "person_name": {"classes": ["name"], "partial": "initials", "full": "redacted", "types": ["STRING"]},
    "date": {"classes": ["date_of_birth", "medical_date"], "partial": "year", "full": "null", "types": ["DATE", "TIMESTAMP"]},
    "age": {"classes": ["age"], "partial": "age_band_10", "full": "null", "types": ["NUMERIC"]},
    "credit_score": {"classes": ["credit_score"], "partial": "credit_score_band_50", "full": "null", "types": ["NUMERIC"]},
    "compensation": {"classes": ["compensation"], "partial": "rounded", "full": "null", "types": ["NUMERIC"]},
    "ip_address": {"classes": ["ip_address"], "partial": "ip_network", "full": "redacted", "types": ["STRING"]},
    "mac_address": {"classes": ["mac_address"], "partial": "mac_vendor", "full": "redacted", "types": ["STRING"]},
    "url": {"classes": ["url"], "partial": "url_domain", "full": "redacted", "types": ["STRING"]},
    "location": {"classes": ["location"], "partial_by_type": {"STRING": "redacted", "NUMERIC": "location_1dp"}, "full": "redacted", "types": ["STRING", "NUMERIC"]},
    "sensitive": {"classes": ["biometric_data", "criminal_background", "employment_status", "ethnicity", "genetic_data", "health_data", "marital_status", "political_opinion", "religious_belief", "sexual_data", "sexual_orientation", "trade_union_membership"], "partial": "redacted", "full": "redacted", "types": ["STRING"]},
    "secret": {"classes": ["secret"], "partial": "redacted", "full": "redacted", "types": ["STRING", "DATE", "TIMESTAMP", "NUMERIC"], "never_raw": true}
  }
}
