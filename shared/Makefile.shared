test-self-service-genie: _bootstrap _guard-workspace-target ## Scenario: central governance team applies ABAC, BU teams self-serve Genie agents
	cd "$(CLOUD_ROOT)" && $(_ITEST_RUNNER) \
		--scenario self-service-genie \
		--auth-file "$(_ITEST_AUTH)" \
