def _write_databricks_yml(dev, prod, warehouse_id, parent_path, run_as):
    content = f"""# Generated by ./promote -- edit freely and re-run.
#
# Genie spaces deploy only under the `direct` engine (the default). Do not set
# `engine: terraform` here; the Terraform engine cannot deploy Genie spaces.

bundle:
  name: genie-prod-promotion

include:
  - resources/*.yml

variables:
  warehouse_id:
    description: SQL warehouse backing the Genie spaces in this target.
  parent_path:
    description: Workspace folder the Genie spaces are registered under.

targets:
  # Source workspace. Used for exporting, not for deploying.
  dev:
    mode: development
    default: true
    workspace:
      host: {dev.get('host', '')}
    variables:
      warehouse_id: ""
      parent_path: {parent_path}

  # Target workspace.
  prod:
    mode: production
    workspace:
      host: {prod.get('host', '')}
      root_path: /Workspace/Shared/.bundle/${{bundle.name}}/${{bundle.target}}
    variables:
      warehouse_id: "{warehouse_id}"
      parent_path: {parent_path}
    run_as:
      user_name: {run_as}
"""
    with open(os.path.join(HERE, "databricks.yml"), "w") as handle:
        handle.write(content)


def _write_spaces_yml(chosen, catalog_map):
    """Write spaces.yml, with each space's own mapping nested under it.

    A space's own catalog_map wins over the top-level one, which acts as a
    default for spaces that do not define theirs.
    """
    lines = [
        "# Generated by ./promote -- edit freely and re-run.",
        "",
        "# Default dev -> prod table mapping, used by any space below that does",
        "# not define its own catalog_map. Applied to every table reference in",
        "# the space, including example SQL and curated instructions.",
        "catalog_map:",
    ]
    if catalog_map:
        for dev_name, prod_name in catalog_map.items():
            lines.append(f"  {dev_name}: {prod_name}")
    else:
        lines.append("  {}")

    lines += [
        "",
        "# Each space may carry its own catalog_map, which overrides the default",
        "# above -- different spaces usually read different catalogs.",
        "#",
        "# prod_id present  -> the bundle adopts (binds) that existing prod space",
        "#                     and overwrites it with dev's content on deploy.",
        "# prod_id absent   -> a new space is created; no bind is needed because",
        "#                     the deploy records the new ID in bundle state.",
        "spaces:",
    ]
    for space in chosen:
        lines.append(f"  - key: {space['key']}")
        lines.append(f"    dev_id: {space['dev_id']}")
        if space.get("title"):
            lines.append(f"    # title in dev: {space['title']}")
        if space.get("prod_id"):
            lines.append(f"    prod_id: {space['prod_id']}")
        own = space.get("catalog_map") or {}
        if own:
            lines.append("    catalog_map:")
            for dev_name, prod_name in own.items():
                lines.append(f"      {dev_name}: {prod_name}")
    lines.append("")

    with open(os.path.join(HERE, "spaces.yml"), "w") as handle:
        handle.write("\n".join(lines))


def load_saved_config():
    """Read a previous run's spaces.yml and databricks.yml, if usable.

    Returns None when there is nothing to reuse, so the caller falls through to
    the full wizard.
    """
    spaces_path = os.path.join(HERE, "spaces.yml")
    bundle_path = os.path.join(HERE, "databricks.yml")

    if not (os.path.exists(spaces_path) and os.path.exists(bundle_path)):
        return None

    try:
        with open(bundle_path) as handle:
            bundle_text = handle.read()
    except OSError:
        return None

    # A file still carrying placeholders was never completed.
    if "REPLACE" in bundle_text:
        return None

    sys.path.insert(0, os.path.join(HERE, "lib"))
    import read_config

    try:
        spaces = read_config.parse_spaces(spaces_path)
        catalog_map = dict(
            pair.split("=", 1)
            for pair in read_config.parse_catalog_map(spaces_path)
            if "=" in pair
        )
    except Exception:
        return None

    if not spaces:
        return None

    hosts = {}
    for target in ("dev", "prod"):
        match = re.search(
            r"^  " + target + r":.*?^      host:\s*(\S+)",
            bundle_text,
            re.MULTILINE | re.DOTALL,
        )
        if match:
            hosts[target] = match.group(1)

    return {
        "spaces": spaces,
        "catalog_map": catalog_map,
        "hosts": hosts,
        "warehouse_id": read_config.parse_warehouse(bundle_path, "prod"),
    }


def profile_for_host(host):
    """Find the CLI profile pointing at a host, so saved config maps back.

    Prefers a profile the CLI reports as authenticated: several profiles can
    share a host, and picking a stale one would fail later for no good reason.
    """
    if not host:
        return None

    wanted = host.rstrip("/")
    matches = [p for p in list_profiles()
               if (p.get("host") or "").rstrip("/") == wanted]
    if not matches:
        return None

    for profile in matches:
        if profile.get("valid"):
            return profile
    return matches[0]


def step_reuse(saved):
    """Reuse a saved configuration, but always ask which spaces to promote.

    The workspaces, warehouse, folder and table mappings are plumbing: once set
    they rarely change, so they are reused silently. Which spaces to promote is
    the actual decision each time, so that question is always asked.

    Returns True when the promotion ran, False to fall through to full setup.
    """
    section(2, TOTAL_STEPS, "Using your saved setup")

    print(f"  {BOLD}Source{RESET}      {saved['hosts'].get('dev', '?')}")
    print(f"  {BOLD}Target{RESET}      {saved['hosts'].get('prod', '?')}")
    print(f"  {BOLD}Warehouse{RESET}   {saved['warehouse_id'] or '(unset)'}")
    if saved["catalog_map"]:
        mappings = ", ".join(f"{k} → {v}" for k, v in saved["catalog_map"].items())
        print(f"  {BOLD}Mappings{RESET}    {mappings}")

    # This validates every profile in ~/.databrickscfg and can take a few
    # seconds, so say so rather than sitting silent.
    print(f"\n  {DIM}Matching those hosts to your CLI profiles...{RESET}",
          flush=True)

    dev = profile_for_host(saved["hosts"].get("dev"))
    prod = profile_for_host(saved["hosts"].get("prod"))

    if not dev or not prod:
        missing = "dev" if not dev else "prod"
        warn(f"no CLI profile points at the saved {missing} host, so this "
             f"configuration cannot be reused as-is")
        print(f"  {DIM}Fix with: databricks auth login --host "
              f"{saved['hosts'].get(missing, '<host>')} --profile {missing}{RESET}")
        return False

    ok(f"profiles: {dev['name']} (dev), {prod['name']} (prod)")

    if not confirm("\n  Use this setup?", default=True):
        change = choose(
            "What do you want to change?",
            [
                {"id": "workspaces", "label": "The dev or prod workspace",
                 "hint": "also re-asks warehouse, folder and owner"},
                {"id": "mappings", "label": "Table mappings only",
                 "hint": "keeps the workspaces; set per space"},
                {"id": "fresh", "label": "Everything",
                 "hint": "walks through the full setup again"},
            ],
            lambda option: (f"{option['label']}\n         "
                            f"{DIM}{option['hint']}{RESET}"),
        )
        if change["id"] in ("workspaces", "fresh"):
            return False
        # Mappings only: drop the saved ones so each space is asked afresh.
        saved = dict(saved)
        saved["catalog_map"] = {}
        saved["spaces"] = [dict(s, catalog_map={}) for s in saved["spaces"]]

    if not _select_spaces_with_saved(saved, dev, prod):
        return False

    _run_promotion(dev, prod)
    return True


def _select_spaces_with_saved(saved, dev, prod):
    """Pick which spaces to promote, reusing saved keys and mappings.

    Lists every dev space, marking the ones already configured, and reuses their
    saved resource key so the bundle keeps tracking the same prod space. Only
    asks about table mappings when a picked space references something the saved
    mapping does not cover.
    """
    section(3, TOTAL_STEPS, "Picking Genie spaces to promote")

    print(f"  {DIM}Listing Genie spaces in dev...{RESET}", flush=True)
    all_spaces = list_genie_spaces(dev["name"])
    if not all_spaces:
        warn("could not list dev spaces; falling back to full setup")
        return False

    saved_by_dev_id = {s["dev_id"]: s for s in saved["spaces"]}

    # Configured spaces first: they are the likely repeat choice.
    ordered = sorted(all_spaces, key=lambda s: (
        s.get("space_id") not in saved_by_dev_id,
        (s.get("title") or "").lower(),
    ))

    def label(space):
        if space.get("space_id") in saved_by_dev_id:
            return f"{space.get('title') or '(untitled)'}  {DIM}promoted before{RESET}"
        return space.get("title") or "(untitled)"

    picked = _pick_spaces(ordered, labeller=label)

    chosen = []
    taken = set()
    for space in picked:
        dev_id = space.get("space_id")
        title = space.get("title") or "untitled"
        previous = saved_by_dev_id.get(dev_id)

        if previous:
            # Reuse the saved key silently. Changing it would make the bundle
            # treat the space as new and create a duplicate in prod.
            key = previous["key"]
            chosen.append({"key": key, "dev_id": dev_id, "title": title,
                           "prod_id": previous.get("prod_id", "")})
            taken.add(key)
            continue

        suggested = _suggest_key(title)
        while suggested in taken or suggested in {s["key"] for s in saved["spaces"]}:
            suggested += "_2"
        print()
        key = ask(f"Resource key for {BOLD}{title}{RESET}",
                  default=suggested,
                  validate=lambda value: ("already used in this run"
                                          if value in taken else valid_key(value)))
        taken.add(key)
        chosen.append({"key": key, "dev_id": dev_id, "title": title})

    # Mappings are per space: each one usually reads its own catalogs.
    for space in chosen:
        previous = saved_by_dev_id.get(space["dev_id"]) or {}
        space["catalog_map"] = dict(previous.get("catalog_map")
                                   or saved["catalog_map"])
    _map_each_space(dev, prod, chosen)

    _resolve_prod_targets(prod, chosen)

    # Keep configured-but-unpicked spaces in the file so their prod links are not
    # lost; promote_genie.sh is told which subset to act on.
    picked_dev_ids = {s["dev_id"] for s in chosen}
    retained = [s for s in saved["spaces"] if s["dev_id"] not in picked_dev_ids]
    # Mappings live on each space now; the top-level one stays as the default for
    # spaces that carry none of their own.
    _write_spaces_yml(chosen + retained, saved["catalog_map"])

    if retained:
        names = ", ".join(s["key"] for s in retained)
        print(f"  {DIM}Not promoting this run (kept in spaces.yml): {names}{RESET}")

    _write_selection(chosen)
    ok(f"promoting {len(chosen)} space(s)")
    return True


def _map_each_space(dev, prod, chosen):
    """Confirm or build a table mapping for each space individually.

    A space whose existing mapping already covers every table it references is
    left alone; only gaps prompt for input. Spaces read different catalogs, so a
    single shared mapping cannot express a real setup.
    """
    section(4, TOTAL_STEPS, "Table mappings per space")

    sys.path.insert(0, os.path.join(HERE, "lib"))
    import rewrite_catalog

    for space in chosen:
        print(f"\n  {BOLD}{space['key']}{RESET}")

        referenced = space_table_names(dev["name"], space["dev_id"])
        if not referenced:
            print(f"    {DIM}could not read its tables; leaving its mapping "
                  f"as-is{RESET}")
            continue

        current = space.get("catalog_map") or {}
        if current:
            for dev_name, prod_name in current.items():
                print(f"    {DIM}{dev_name} → {prod_name}{RESET}")

        unmapped = sorted(
            table for table in referenced
            if rewrite_catalog.rewrite_string(table, current)[1] == 0
        )

        if not unmapped:
            ok(f"all {len(referenced)} table(s) covered")
            if current and not confirm("    Change this mapping?", default=False):
                continue
            if current:
                space["catalog_map"] = step_catalog_map(dev, prod, [space])
            continue

        warn(f"{len(unmapped)} table(s) not covered by a mapping:")
        for table in unmapped[:10]:
            print(f"        {table}")
        if len(unmapped) > 10:
            print(f"        {DIM}... and {len(unmapped) - 10} more{RESET}")

        if confirm("    Map them now?", default=True):
            extra = step_catalog_map(dev, prod, [space])
            merged = dict(current)
            merged.update(extra)
            space["catalog_map"] = merged
        else:
            print(f"    {DIM}left unmapped; those tables will keep their dev "
                  f"names in prod{RESET}")


def _write_selection(chosen):
    """Record which keys this run should act on, for promote_genie.sh."""
    path = os.path.join(HERE, ".promote-selection")
    with open(path, "w") as handle:
        for space in chosen:
            handle.write(space["key"] + "\n")




def _run_promotion(dev, prod):
    """Run the dry run, then offer to deploy. Shared by both entry paths."""
    command = ["./promote_genie.sh", "--dev-profile", dev["name"],
               "--prod-profile", prod["name"]]

    print(f"\n{BOLD}{BLUE}Dry run{RESET}")
    print(f"  {DIM}Exports from dev, rewrites table names, and shows what would")
    print(f"  change in prod -- including what differs inside each space.")
    print(f"  Nothing is written to prod.{RESET}\n")
    sys.stdout.flush()

    if subprocess.run(command, cwd=HERE).returncode != 0:
        die("the dry run reported a problem; fix it and run ./promote again")

    print(f"\n{BOLD}{BLUE}Deploy{RESET}")
    if not confirm("Deploy to prod now?", default=False):
        print(f"\n  When you are ready:\n    {BOLD}{' '.join(command)} --apply{RESET}")
        return

    print()
    if subprocess.run(command + ["--apply"], cwd=HERE).returncode != 0:
        die("deploy failed; see the output above")


def main():
    banner()

    reconfigure = "--reconfigure" in sys.argv
    step_preflight()

    # A selection from a previous run must not silently apply to this one.
    selection = os.path.join(HERE, ".promote-selection")
    if os.path.exists(selection):
        os.unlink(selection)

    saved = None if reconfigure else load_saved_config()
    if saved and step_reuse(saved):
        print()
        return

    dev, prod = step_profiles()
    chosen = step_pick_spaces(dev)
    _map_each_space(dev, prod, chosen)
    warehouse_id, parent_path, run_as = step_prod_targets(prod, chosen)
    step_write_and_run(dev, prod, chosen, {}, warehouse_id,
                       parent_path, run_as)
    _write_selection(chosen)
    print()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\ncancelled")
        sys.exit(130)
