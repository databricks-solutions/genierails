# ─────────────────────────────────────────────────────────────────────────────
# Scheduled steady-state governance — opt-in snippet
# ─────────────────────────────────────────────────────────────────────────────
# These variables are consumed by the workspace root
# (roots/workspace/scheduled_governance.tf). They are DISABLED by default, so
# leaving them unset changes nothing about `make apply`.
#
# To enable the scheduled prod re-scan, copy the block below into the target
# environment's env.auto.tfvars (e.g. aws/envs/prod/env.auto.tfvars) — that is
# the tfvars file the workspace layer loads — then run `make apply ENV=prod`.
# ─────────────────────────────────────────────────────────────────────────────

# Turn the scheduled job on. Default is false.
enable_scheduled_governance = true

# Which environment the scan targets, and which cloud subdir holds its envs/.
scheduled_governance_env   = "prod"
scheduled_governance_cloud = "aws" # "aws" | "azure"

# Optional catalog threaded to the generate-delta step (generate_abac.py
# --catalog). Empty = auto-derive from the target env's uc_tables.
scheduled_governance_catalog = "prod_fin"

# Cadence (Quartz cron) and timezone. Default: daily at 06:00 UTC.
scheduled_governance_cron     = "0 0 6 * * ?"
scheduled_governance_timezone = "UTC"

# Repo the job checks out to run the existing steady-state entrypoints. The
# checkout provides CODE only. Required when enable_scheduled_governance = true.
scheduled_governance_git_url      = "https://github.com/<org>/<repo>"
scheduled_governance_git_branch   = "main"
scheduled_governance_git_provider = "gitHub" # gitHub | gitLab | bitbucketCloud | azureDevOpsServices | ...

# Where the job reads the env config from at runtime. REQUIRED when enabled:
# the repo's envs/ is .gitignore'd, so the checkout does NOT contain
# envs/<env>/. Point this at a runtime-visible path (a Unity Catalog Volume,
# workspace files, or a DBFS mount) holding this env's auth.auto.tfvars,
# env.auto.tfvars, data_access/ and (optionally) generated/. The wrapper copies
# it into the checkout's env dir before scanning.
scheduled_governance_config_source = "/Volumes/main/governance/genierails/prod"

# Optional: who to email when the job fails (e.g. drift found but not resolved).
scheduled_governance_notification_emails = ["governance-team@example.com"]

# Optional: PyPI packages installed into the serverless environment. The
# defaults cover audit + coverage + the non-LLM delta path; append your LLM
# provider package (e.g. "anthropic") if the delta step must classify new
# columns.
# scheduled_governance_dependencies = ["python-hcl2", "databricks-sdk", "pyyaml", "requests"]

# Optional: override the generated job name.
# scheduled_governance_job_name = "GenieRails steady-state governance (prod)"
