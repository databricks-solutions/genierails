-- GENERATED MASKING FUNCTIONS (deterministic governance)
USE CATALOG dev_fin;
USE SCHEMA payments;

-- === GenieRails deterministic mask library ===
USE CATALOG dev_fin;
USE SCHEMA payments;

CREATE OR REPLACE FUNCTION gr_mask_card_security_code__string__26d4b17e_full(value STRING) RETURNS STRING RETURN CAST((CASE WHEN value IS NULL THEN NULL ELSE '[REDACTED]' END) AS STRING);

CREATE OR REPLACE FUNCTION gr_mask_date_year__date__7d691823_partial(value DATE) RETURNS DATE RETURN CAST((CASE WHEN value IS NULL THEN NULL ELSE make_date(year(value), 1, 1) END) AS DATE);

CREATE OR REPLACE FUNCTION gr_mask_date_year__date__7d691823_full(value DATE) RETURNS DATE RETURN CAST(NULL AS DATE);

CREATE OR REPLACE FUNCTION gr_mask_email_partial__string__f86256b2_partial(value STRING) RETURNS STRING RETURN CAST((CASE WHEN value IS NULL THEN NULL WHEN trim(value) NOT RLIKE '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$' THEN '[REDACTED]' ELSE concat(left(trim(value), 1), '***@', lower(substring_index(trim(value), '@', -1))) END) AS STRING);

CREATE OR REPLACE FUNCTION gr_mask_email_partial__string__f86256b2_full(value STRING) RETURNS STRING RETURN CAST((CASE WHEN value IS NULL THEN NULL ELSE '[REDACTED]' END) AS STRING);

CREATE OR REPLACE FUNCTION gr_mask_ssn__string__8277f91e_partial(value STRING) RETURNS STRING RETURN CAST((CASE WHEN value IS NULL THEN NULL ELSE '[REDACTED]' END) AS STRING);

CREATE OR REPLACE FUNCTION gr_mask_ssn__string__8277f91e_full(value STRING) RETURNS STRING RETURN CAST((CASE WHEN value IS NULL THEN NULL ELSE '[REDACTED]' END) AS STRING);

